{
  "name": "pi-durable-memory",
  "version": "0.1.0",
  "description": "Hierarchical long-term memory for Pi Durable agents on Cloudflare Durable Objects: one object per scope with an append-only log, a binary summary tree, bounded wake, full-text recall and zoom. Injected summarizer.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./jev": {
      "types": "./dist/jev/index.d.ts",
      "import": "./dist/jev/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:workers"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@typesafe-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.18.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zod": "^4.4.3"
  }
}
